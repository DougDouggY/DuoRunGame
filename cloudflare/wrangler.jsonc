{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "duo-rush-relay",
  "main": "worker.js",
  "compatibility_date": "2026-07-01",
  "workers_dev": true,
  "vars": {
    "CLIENT_ORIGINS": "https://dougdouggy.github.io,http://127.0.0.1:8080,http://localhost:8080",
    "ROOM_TTL_SECONDS": "21600"
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "DuoRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DuoRoom"] }],
  "observability": { "enabled": false }
}
